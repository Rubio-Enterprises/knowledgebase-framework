{
  "name": "knowledgebase-framework",
  "customizations": {
    "fly-durable": {
      "setupHosts": [
        "static.rust-lang.org",
        "sh.rustup.rs",
        "index.crates.io",
        "static.crates.io",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "storage.googleapis.com"
      ]
    }
  },
  "securityOpt": ["no-new-privileges=false"],
  "onCreateCommand": "mise run setup",
  "remoteEnv": {
    "NODE_AUTH_TOKEN": "${localEnv:NODE_AUTH_TOKEN}"
  },
  "build": {
    "dockerfile": "../../.standards/node_modules/@rubio-enterprises/standards/image/Dockerfile",
    "context": "../..",
    "target": "local"
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/apt-packages:1.0.6": {
      "packages": "graphviz"
    }
  }
}
