{
  "name": "knowledgebase-framework",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "dev",
  "initializeCommand": ["sh", "bin/dev-environment.sh"],
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "fly-durable": {
      "setupHosts": [
        "static.rust-lang.org",
        "sh.rustup.rs",
        "index.crates.io",
        "static.crates.io",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "storage.googleapis.com"
      ]
    }
  }
}
