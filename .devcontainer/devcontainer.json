{
  "name": "knowledgebase-framework",
  "image": "mcr.microsoft.com/devcontainers/base:2.2.1-trixie",
  "features": {
    "ghcr.io/rubio-enterprises/devcontainer-features/baseline:3.0.1": {},
    "ghcr.io/devcontainers-extra/features/apt-packages:1.0.6": {
      "packages": "graphviz"
    }
  },
  "customizations": {
    "fly-durable": {
      "setupHosts": [
        "static.rust-lang.org",
        "sh.rustup.rs",
        "index.crates.io",
        "static.crates.io",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "storage.googleapis.com"
      ]
    }
  },
  "securityOpt": ["no-new-privileges=false"],
  "updateContentCommand": "bash -c 'source scripts/common/standards-pin.sh && standards_devcontainer_setup \"$PWD\" --check-only && exec \"$@\"' standards-lifecycle bash -c 'mise run setup'",
  "containerEnv": {
    "STANDARDS_DEVCONTAINER": "1"
  },
  "onCreateCommand": "bash -c 'source scripts/common/standards-pin.sh && standards_devcontainer_setup \"$PWD\" --check-only'"
}
