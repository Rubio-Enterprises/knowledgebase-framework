{
  "name": "knowledgebase-framework",
  "image": "mcr.microsoft.com/devcontainers/base:2.2.1-trixie",
  "features": {
    "ghcr.io/rubio-enterprises/devcontainer-features/baseline:3.0.0": {},
    "ghcr.io/devcontainers-extra/features/apt-packages:1.0.6": {
      "packages": "graphviz"
    }
  },
  "customizations": {
    "fly-durable": {
      "setupHosts": [
        "static.rust-lang.org",
        "sh.rustup.rs",
        "index.crates.io",
        "static.crates.io",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ]
    }
  },
  "securityOpt": ["no-new-privileges=false"],
  "updateContentCommand": "mise run setup"
}
