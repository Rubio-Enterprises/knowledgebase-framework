{
  "name": "knowledgebase-framework",
  "image": "ghcr.io/rubio-enterprises/knowledgebase-framework/devcontainer:main",
  "customizations": {
    "fly-durable": {
      "setupHosts": [
        "static.rust-lang.org",
        "sh.rustup.rs",
        "index.crates.io",
        "static.crates.io",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "storage.googleapis.com"
      ]
    }
  },
  "securityOpt": ["no-new-privileges=false"],
  "onCreateCommand": "mise run setup",
  "remoteEnv": {
    "NODE_AUTH_TOKEN": "${localEnv:NODE_AUTH_TOKEN}"
  }
}
