{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledgebase-frontmatter",
  "title": "Knowledgebase frontmatter",
  "description": "What OKF's own validator does not check: the Diátaxis type, the genre and work_item extension keys, and the fields every knowledgebase requires. Fetched with the Knowledgebase Framework Hooks; docs/layout-rationale.md explains it.",
  "type": "object",
  "properties": {
    "type": {
      "enum": ["How-to guide", "Reference", "Explanation", "Tutorial"]
    },
    "genre": {
      "enum": ["Research", "Investigation", "Runbook", "Plan", "Decision", "Map"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "not": { "enum": ["how-to", "reference", "explanation", "tutorial"] }
      }
    },
    "status": { "enum": ["draft", "stable"] },
    "work_item": { "$ref": "#/$defs/hyperlink" },
    "generated": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": { "$ref": "#/$defs/actor" },
        "at": { "$ref": "#/$defs/instant" }
      }
    },
    "verified": {},
    "resource": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "resource"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "resource": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "$ref": "#/$defs/actor" },
          "last_modified": { "$ref": "#/$defs/instant" }
        }
      }
    },
    "stale_after": { "$ref": "#/$defs/instant" }
  },
  "required": ["type", "genre", "title", "description", "tags", "status", "generated"],
  "additionalProperties": false,
  "$defs": {
    "hyperlink": {
      "description": "Exactly one Markdown hyperlink, e.g. [owner/repo#123](https://github.com/owner/repo/issues/123): not a bare URL, not a list.",
      "type": "string",
      "pattern": "^\\[[^\\[\\]\\n]+\\]\\(https?://[^\\s()]+\\)$"
    },
    "actor": {
      "type": "string",
      "pattern": "^(human:[a-z0-9._-]+|process:.+|[^\\s/]+/[^\\s]+)$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
